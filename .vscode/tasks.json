{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Кривые слуха",
      "type": "shell",
      "command": "python -u tools/hearing_curves/app.py",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONIOENCODING": "utf-8"
